{
  "name": "@petadopt/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "echo 'No build needed for JS backend'",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts,.js",
    "format": "prettier --write src/",
    "test": "vitest --run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --loader ts-node/esm prisma/seed.js",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@petadopt/shared": "workspace:^",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.38.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-fetch": "^3.3.2",
    "resend": "^6.25.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "prisma": "^7.9.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
